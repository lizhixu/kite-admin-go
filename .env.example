# Server Configuration
SERVER_PORT=:8090

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=admin_system

# JWT Configuration
JWT_SECRET=your-secret-key
JWT_EXPIRE_HOURS=24

# Scheduler
# Disabled by default. Set to true only in trusted deployments that need OS shell tasks.
ALLOW_SHELL_TASKS=false
